# .htaccess (root)
RewriteEngine On

# Serve existing files/folders as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Stop recursion if request already targets index.php
RewriteCond %{REQUEST_URI} !^/index\.php$
# Stop recursion if ?p= is already present
RewriteCond %{QUERY_STRING} !(^|&)p=
# Internally route everything else to index.php (NO redirect)
RewriteRule ^(.+)$ index.php?p=$1 [L,QSA]

# Root path -> index.php
RewriteRule ^$ index.php [L]
